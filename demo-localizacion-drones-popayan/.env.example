# Plantilla de variables de entorno para la demo P3 (localización Popayán, simulada).
# Copiar a `.env` (ignorado por git) y ajustar. No poner aquí secretos reales.

# Token de la API local. Cambiar por un valor propio; nunca subir el `.env` real.
POPAYAN_API_TOKEN=cambia-este-valor

# Ruta de la base SQLite de ejecución (relativa a la raíz del proyecto).
# Es un archivo generado; no se sube a git.
POPAYAN_DB_PATH=data/runtime/popayan_demo.sqlite

# Abrir el dashboard en el navegador al arrancar: 1 = sí, 0 = no.
POPAYAN_DEMO_OPEN=0

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "title": "Observation",
  "description": "Contrato compartido de observacion v1.0.0. P2 (audio) exporta observaciones con este esquema y P3 las ingiere. Espejo Pydantic: demo-localizacion-drones-popayan/src/contracts/observation.py",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "station_id", "sensor_type", "timestamp_utc", "data_origin", "is_simulated"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "station_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "sensor_type": {"enum": ["remote_id", "acoustic", "rf", "optical", "radar", "manual"]},
    "timestamp_utc": {"type": "string", "format": "date-time", "description": "ISO 8601 con zona horaria (UTC)"},
    "data_origin": {"enum": ["simulation", "replay", "sensor", "manual"]},
    "is_simulated": {"type": "boolean"},
    "object_id": {"type": ["string", "null"], "maxLength": 128},
    "classification": {"type": ["string", "null"], "maxLength": 64},
    "classifier_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "altitude": {"type": ["number", "null"], "minimum": -500, "maximum": 20000, "description": "metros"},
    "altitude_reference": {"enum": ["agl", "msl", "wgs84", "takeoff", "unknown", null]},
    "measurement_uncertainty": {"type": ["number", "null"], "minimum": 0, "description": "metros, horizontal 1-sigma"},
    "sensor_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "raw_reference": {"type": ["string", "null"], "maxLength": 512}
  },
  "allOf": [
    {
      "description": "data_origin == simulation  <=>  is_simulated == true",
      "if": {"properties": {"data_origin": {"const": "simulation"}}, "required": ["data_origin"]},
      "then": {"properties": {"is_simulated": {"const": true}}},
      "else": {"properties": {"is_simulated": {"const": false}}}
    },
    {
      "description": "latitude y longitude van juntas",
      "if": {"properties": {"latitude": {"type": "number"}}, "required": ["latitude"]},
      "then": {"properties": {"longitude": {"type": "number"}}, "required": ["longitude"]}
    },
    {
      "if": {"properties": {"longitude": {"type": "number"}}, "required": ["longitude"]},
      "then": {"properties": {"latitude": {"type": "number"}}, "required": ["latitude"]}
    },
    {
      "description": "altitude exige altitude_reference",
      "if": {"properties": {"altitude": {"type": "number"}}, "required": ["altitude"]},
      "then": {"properties": {"altitude_reference": {"enum": ["agl", "msl", "wgs84", "takeoff", "unknown"]}}, "required": ["altitude_reference"]}
    },
    {
      "description": "una observacion acustica no lleva coordenadas ni altitud",
      "if": {"properties": {"sensor_type": {"const": "acoustic"}}, "required": ["sensor_type"]},
      "then": {
        "properties": {
          "latitude": {"type": "null"},
          "longitude": {"type": "null"},
          "altitude": {"type": "null"}
        }
      }
    }
  ]
}
